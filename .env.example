# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Required in production. For Supabase use the
# connection pooler URI (Project Settings → Database → Connection string → "Transaction").
# Leave empty locally to use the embedded PGlite database in ./.data/pglite.
DATABASE_URL=
# Run pending migrations automatically when the server first connects (true/false).
AUTO_MIGRATE=false
DATABASE_POOL_SIZE=5

# ─── Supabase Auth (email magic links) ───────────────────────────────────────
# When both are set, sign-in uses Supabase email OTP links. Safe to expose (public anon key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Enables profile photo uploads to Supabase Storage (public bucket below).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATAR_BUCKET=avatars

# Public URL of the deployment, used in sign-in links and X invites.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Access ──────────────────────────────────────────────────────────────────
# Comma-separated emails that become admins when they sign in.
ADMIN_EMAILS=

# Demo sign-in (no email verification) is ON automatically in development when
# Supabase is not configured. Never enable it on a public deployment.
ENABLE_DEMO_AUTH=false
# 32+ random characters; signs demo-session cookies. Required if ENABLE_DEMO_AUTH=true in production.
SESSION_SECRET=

# ─── X (Twitter) ─────────────────────────────────────────────────────────────
# Official X API v2 bearer token. Enables live recent search on the Conversation page.
X_BEARER_TOKEN=
# Set to false to stop the admin import from fetching post text via X's public oEmbed endpoint.
X_OEMBED_ENABLED=true
