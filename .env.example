# Postgres connection string. Required in production.
# On Railway: add a PostgreSQL database and set DATABASE_URL=${{Postgres.DATABASE_URL}}
# Tables are created automatically on first start. Leave empty locally to use a built-in database.
DATABASE_URL=

# Password for /admin (moderation and adding X posts). Use 12+ random characters.
ADMIN_KEY=
# Secret address of the admin key form: ADMIN_ENTRY=k7q2-front-door gives /admin/k7q2-front-door.
# Once set, /admin is a 404 for everyone who isn't signed in as an admin.
ADMIN_ENTRY=

# Sign-in with Supabase Auth (Project Settings → API). Without these, sign-in is hidden.
# In Supabase → Authentication → URL Configuration: Site URL https://events.latars.xyz,
# Redirect URL https://events.latars.xyz/auth/callback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: comma-separated emails that get /admin when signed in.
ADMIN_EMAILS=
# Local work and tests only: a built-in email + password sign-in when Supabase isn't set.
# LOCAL_AUTH=true
# SESSION_SECRET=

# Optional: official X API v2 bearer token, to pull posts about Moonshot automatically.
X_BEARER_TOKEN=
# Set to false to stop filling in post text from X's public embed when importing.
X_OEMBED_ENABLED=true
# Set to false to stop showing images and profile pictures from X posts.
X_IMAGES_ENABLED=true

# Optional: public URL of the site.
# The public address used in share links and previews (the new domain).
NEXT_PUBLIC_SITE_URL=https://events.latars.xyz

# Optional anti-spam limits per network (venue Wi-Fi often shares one IP).
RATE_LIMIT_CARDS_PER_HOUR=60
RATE_LIMIT_MOMENTS_PER_HOUR=40

# Optional: force the event-days site (live) or the after-Moonshot site (after). Default: by date.
# EVENT_MODE=
